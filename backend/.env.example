# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# In Docker Compose, this will be: mongodb://mongo:27017/apisentinel
MONGODB_URI=mongodb://localhost:27017/apisentinel

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Automated Health Monitoring Scheduler
AUTO_PING_ENABLED=true
PING_DEFAULT_INTERVAL_SEC=30

# SSRF Security Settings
# In production, private IPs (127.0.0.1, 10.x, 192.168.x, 169.254.x) are blocked.
# Set to 'true' only if you are explicitly testing internal mock servers in local dev.
SSRF_ALLOW_PRIVATE_IPS=false

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
