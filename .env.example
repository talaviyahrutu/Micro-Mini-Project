# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=sentinel_super_secure_jwt_secret_key_production_2026
JWT_EXPIRES_IN=7d

# Database Configuration
# Options: 'sqlite' or 'postgres'
# When using Docker Compose, set DB_DIALECT=postgres and configure host 'db'
DB_DIALECT=sqlite
DB_STORAGE=./data/sentinel.sqlite

# PostgreSQL settings (Used when DB_DIALECT=postgres or in Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apisentinel
DB_USER=sentinel
DB_PASSWORD=sentinel_secret

# Health Ping Engine Settings
AUTO_PING_ENABLED=true
PING_INTERVAL_MS=30000
DEFAULT_TIMEOUT_MS=5000
