# ========================================================
# API Sentinel — Environment Variable Configuration
# Copy this file to .env and provide your deployment secrets
# ========================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Backend HTTP Server Port
PORT=5000

# MongoDB Database Connection String
# Local standalone: mongodb://localhost:27017/apisentinel
# Docker Compose:   mongodb://mongo:27017/apisentinel
# Kubernetes:       mongodb://mongo-service:27017/apisentinel
MONGODB_URI=mongodb://localhost:27017/apisentinel

# JWT Authentication Secret (Use minimum 32 random characters in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Automated Probe Engine Settings
AUTO_PING_ENABLED=true
PING_DEFAULT_INTERVAL_SEC=30

# SSRF Security Policy
# Set to 'false' in production to block internal loopback/private RFC1918 IPs
SSRF_ALLOW_PRIVATE_IPS=false

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
