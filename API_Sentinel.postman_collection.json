{
  "info": {
    "_postman_id": "api-sentinel-mongo-v2",
    "name": "API Sentinel — REST API Test Suite",
    "description": "Comprehensive Postman test collection for the MongoDB-backed API Sentinel Platform with pre-request scripts, automated token extraction, and response validations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. System Health Probe",
      "item": [
        {
          "name": "Liveness & DB Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/healthz", "host": ["{{baseUrl}}"], "path": ["healthz"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Database is connected', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "    pm.expect(json.database).to.eql('connected');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Admin (Extracts Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Contains JWT token', function () { pm.expect(json.token).to.be.a('string'); });",
                  "if (json.token) {",
                  "    pm.environment.set('token', json.token);",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sentinel.dev\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login as Analyst",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@sentinel.dev\",\n  \"password\": \"analyst123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DevOps Engineer\",\n  \"email\": \"devops@sentinel.dev\",\n  \"password\": \"devops123\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Get Current User Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. API Fleet Management (CRUD)",
      "item": [
        {
          "name": "List All Registered APIs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Returned API array', function () { pm.expect(json.data).to.be.an('array'); });",
                  "if (json.data && json.data.length > 0) {",
                  "    pm.environment.set('apiId', json.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/apis?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "apis"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Register New Target API",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cloudflare 1.1.1.1 Probe\",\n  \"url\": \"https://1.1.1.1\",\n  \"method\": \"GET\",\n  \"expectedStatusCode\": 200,\n  \"interval\": 30,\n  \"timeout\": 4000,\n  \"enabled\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/apis", "host": ["{{baseUrl}}"], "path": ["api", "apis"] }
          }
        },
        {
          "name": "Get API Details by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/apis/{{apiId}}", "host": ["{{baseUrl}}"], "path": ["api", "apis", "{{apiId}}"] }
          }
        },
        {
          "name": "Trigger Manual Health Check Now",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/apis/{{apiId}}/check", "host": ["{{baseUrl}}"], "path": ["api", "apis", "{{apiId}}", "check"] }
          }
        },
        {
          "name": "Get API Health History & Sparkline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/apis/{{apiId}}/history?limit=20", "host": ["{{baseUrl}}"], "path": ["api", "apis", "{{apiId}}", "history"], "query": [{ "key": "limit", "value": "20" }] }
          }
        }
      ]
    },
    {
      "name": "3. Dashboard & Incident Command",
      "item": [
        {
          "name": "Get Dashboard Summary KPIs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Has summary metrics', function () { pm.expect(json.data.summary.totalApis).to.be.a('number'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "stats"] }
          }
        },
        {
          "name": "List All Incidents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "    pm.environment.set('incidentId', json.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/incidents?status=all", "host": ["{{baseUrl}}"], "path": ["api", "incidents"], "query": [{ "key": "status", "value": "all" }] }
          }
        },
        {
          "name": "Update Incident Lifecycle Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"investigating\",\n  \"note\": \"Triaging automated alert and checking downstream database connectivity.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "incidents", "{{incidentId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "4. Outage Simulator & Mock Targets",
      "item": [
        {
          "name": "Probe Payment Mock (Normal 200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/mock/payment-gateway", "host": ["{{baseUrl}}"], "path": ["api", "mock", "payment-gateway"] }
          }
        },
        {
          "name": "Toggle Simulated Outage (Simulates 503)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"payment\",\n  \"down\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/mock/toggle-outage", "host": ["{{baseUrl}}"], "path": ["api", "mock", "toggle-outage"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "apiId", "value": "", "type": "string" },
    { "key": "incidentId", "value": "", "type": "string" }
  ]
}
