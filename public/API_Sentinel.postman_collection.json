{
  "info": {
    "_postman_id": "api-sentinel-collection-v1",
    "name": "API Sentinel — Health & Incident Management",
    "description": "Comprehensive Postman test collection for API Sentinel with automated tests and token saving.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "1. Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@apisentinel.dev\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "2. Login as Analyst",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@apisentinel.dev\",\n  \"password\": \"User@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "3. Register Custom User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@cyberdyne.dev\",\n  \"password\": \"Security@123\",\n  \"role\": \"analyst\",\n  \"department\": \"Incident Command\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "4. Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "5. List Engineers / Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/users", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users"] }
          }
        }
      ]
    },
    {
      "name": "📡 Monitors (CRUD & Pings)",
      "item": [
        {
          "name": "1. List Monitors (with Search & Filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/monitors?environment=production",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitors"],
              "query": [{ "key": "environment", "value": "production" }]
            }
          }
        },
        {
          "name": "2. Get Single Monitor with Telemetry",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/monitors/1", "host": ["{{baseUrl}}"], "path": ["api", "monitors", "1"] }
          }
        },
        {
          "name": "3. Create New Monitor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notification SMS Microservice\",\n  \"url\": \"{{baseUrl}}/api/mock/healthy\",\n  \"method\": \"GET\",\n  \"expectedStatusCode\": 200,\n  \"intervalSeconds\": 30,\n  \"timeoutMs\": 4000,\n  \"environment\": \"production\",\n  \"description\": \"Twilio redundant dispatch gateway\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/monitors", "host": ["{{baseUrl}}"], "path": ["api", "monitors"] }
          }
        },
        {
          "name": "4. Trigger Manual Health Ping on Monitor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/monitors/1/ping", "host": ["{{baseUrl}}"], "path": ["api", "monitors", "1", "ping"] }
          }
        },
        {
          "name": "5. Trigger Health Ping on All Active Monitors",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/monitors/ping-all", "host": ["{{baseUrl}}"], "path": ["api", "monitors", "ping-all"] }
          }
        },
        {
          "name": "6. Update Monitor Configuration",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Core Payment Gateway (Updated)\",\n  \"url\": \"{{baseUrl}}/api/mock/healthy\",\n  \"intervalSeconds\": 20,\n  \"timeoutMs\": 3500\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/monitors/1", "host": ["{{baseUrl}}"], "path": ["api", "monitors", "1"] }
          }
        }
      ]
    },
    {
      "name": "🚨 Incident Management",
      "item": [
        {
          "name": "1. List Incidents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/incidents", "host": ["{{baseUrl}}"], "path": ["api", "incidents"] }
          }
        },
        {
          "name": "2. Report Manual Incident",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Payment Gateway Elevated 502 Rate\",\n  \"description\": \"Upstream banking API returned intermittent 502 Bad Gateway during settlement.\",\n  \"severity\": \"high\",\n  \"monitorId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/incidents", "host": ["{{baseUrl}}"], "path": ["api", "incidents"] }
          }
        },
        {
          "name": "3. Acknowledge Incident",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/incidents/1/acknowledge", "host": ["{{baseUrl}}"], "path": ["api", "incidents", "1", "acknowledge"] }
          }
        },
        {
          "name": "4. Add Incident Timeline Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Engaged third-party payment partner on-call lead. Investigation ongoing.\",\n  \"action\": \"PARTNER_CONTACTED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/incidents/1/timeline", "host": ["{{baseUrl}}"], "path": ["api", "incidents", "1", "timeline"] }
          }
        },
        {
          "name": "5. Resolve Incident",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rootCause\": \"DNS propagation delay after cloud region switchover.\",\n  \"resolutionNotes\": \"Flushed regional DNS caches and restored primary routing table.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/incidents/1/resolve", "host": ["{{baseUrl}}"], "path": ["api", "incidents", "1", "resolve"] }
          }
        }
      ]
    },
    {
      "name": "📊 Telemetry & System Diagnostics",
      "item": [
        {
          "name": "1. Telemetry Log Stream",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/health-checks?limit=30", "host": ["{{baseUrl}}"], "path": ["api", "health-checks"] }
          }
        },
        {
          "name": "2. Aggregated Latency & Uptime Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/health-checks/stats", "host": ["{{baseUrl}}"], "path": ["api", "health-checks", "stats"] }
          }
        },
        {
          "name": "3. Platform Health & Diagnostics Probe",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health-checks/system", "host": ["{{baseUrl}}"], "path": ["api", "health-checks", "system"] }
          }
        }
      ]
    },
    {
      "name": "🔬 Outage Simulator & Mock Targets",
      "item": [
        {
          "name": "1. Mock Healthy Target (200 OK)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/mock/healthy", "host": ["{{baseUrl}}"], "path": ["api", "mock", "healthy"] }
          }
        },
        {
          "name": "2. Mock Slow Target (Degraded)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/mock/slow?delay=1200", "host": ["{{baseUrl}}"], "path": ["api", "mock", "slow"] }
          }
        },
        {
          "name": "3. Dynamic Outage Service Target",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/mock/service-target", "host": ["{{baseUrl}}"], "path": ["api", "mock", "service-target"] }
          }
        },
        {
          "name": "4. Toggle Outage Active (Trigger Failure)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/mock/toggle-outage", "host": ["{{baseUrl}}"], "path": ["api", "mock", "toggle-outage"] }
          }
        },
        {
          "name": "5. Toggle Outage Resolved (Restore Health)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/mock/toggle-outage", "host": ["{{baseUrl}}"], "path": ["api", "mock", "toggle-outage"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ]
}
