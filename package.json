{
  "name": "api-sentinel",
  "version": "2.0.0",
  "description": "API Sentinel — API Health Monitoring & Incident Management Platform",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "seed": "cd backend && npm run seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "k8s:deploy": "powershell -ExecutionPolicy Bypass -File ./k8s/deploy-minikube.ps1",
    "test": "cd backend && npm test"
  },
  "keywords": [
    "api-monitoring",
    "health-check",
    "incident-management",
    "mongodb",
    "mongoose",
    "react",
    "vite",
    "docker",
    "kubernetes"
  ],
  "author": "API Sentinel Team",
  "license": "MIT"
}
